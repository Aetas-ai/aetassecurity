# Real sending is disabled until Sir Rob approves and notify.aetassecurity.com is verified.
FORM_DELIVERY_ENABLED=false

# Generate privately: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
FORM_CSRF_SECRET=

# Resend: use a Sending access key restricted to notify.aetassecurity.com.
RESEND_API_KEY=
FORM_SENDER_EMAIL=forms@notify.aetassecurity.com
CONTACT_RECIPIENT_EMAIL=info@aetassecurity.com

# Legacy webhook alternative: clear RESEND_API_KEY and FORM_SENDER_EMAIL first.
# HTTPS endpoint and bearer token remain server-only; no concurrent delivery.
FORM_DELIVERY_URL=
FORM_DELIVERY_BEARER_TOKEN=

# Content placeholders (proof slots, draft resources). Off by default, dev included.
# Set to true to review the slots in dev or for a staging build; a production build with placeholder
# markup and this unset fails (scripts/security-headers-integration.mjs).
PUBLIC_SHOW_PLACEHOLDERS=
