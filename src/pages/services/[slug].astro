---
import ServicePage from '../../components/ServicePage.astro';
import { services, type ServiceDetail } from '../../data/services';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props as { service: ServiceDetail };
---

<ServicePage service={service} />
