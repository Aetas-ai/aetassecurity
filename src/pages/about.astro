---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PartnerMarquee from '../components/PartnerMarquee.astro';
import Button from '../components/Button.astro';
import { demoLink } from '../data/navigation';
import { engagementSteps, expertSteps, principles } from '../data/approach';
---

<Layout socialImage="about" title="About Aetas Security" description="Aetas Security, the cybersecurity practice of Aetas Global Innovation, provides MXDR and Offensive Security guided by experienced security professionals, with Expert Human Oversight of AI.">
  <PageHero
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'About', href: '/about' }]}
    title="Cybersecurity led by experts, with people in control."
    description="Aetas Security, the cybersecurity practice of Aetas Global Innovation, provides Managed Extended Detection and Response (MXDR) and Offensive Security, guided by experienced security professionals."
    accent="security"
    compact
    primaryLabel="Explore services"
    primaryHref="/services"
    secondaryLabel="Contact us"
    secondaryHref="/contact"
  />

  <section id="expert-in-the-loop" class="agi-section" aria-labelledby="expert-heading">
    <div class="mx-auto max-w-7xl">
      <SectionHeading
        id="expert-heading"
        eyebrow="Expert in the Loop"
        title="AI-assisted detection, with experts in control."
        lede="Aetas Security applies Human Led AI to help detect and prioritize threats, with Expert Human Oversight of AI (Expert in the Loop). AI supports the analyst; it does not act on your environment by itself."
      />
      <ol class="agi-steps mt-12" style="--steps: 4">
        {expertSteps.map(([title, body]) => (
          <li class="agi-step">
            <p class="font-display text-[0.9375rem] font-semibold text-white">{title}</p>
            <p class="mt-1 text-[0.8125rem] leading-relaxed text-muted">{body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="agi-band agi-section" aria-labelledby="principles-heading">
    <div class="mx-auto max-w-7xl">
      <SectionHeading id="principles-heading" title="How we work." />
      <ul class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2">
        {principles.map(([title, body]) => (
          <li class="agi-card agi-card--dark">
            <h3 class="font-display text-lg font-semibold text-white">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="agi-section" aria-labelledby="engagement-heading">
    <div class="mx-auto max-w-7xl">
      <SectionHeading id="engagement-heading" title="How engagements run." lede="Every engagement starts with a clear scope and named owners." />
      <ol class="agi-steps mt-12" style="--steps: 4">
        {engagementSteps.map(([title, body]) => (
          <li class="agi-step">
            <p class="font-display text-[0.9375rem] font-semibold text-white">{title}</p>
            <p class="mt-1 text-[0.8125rem] leading-relaxed text-muted">{body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <PartnerMarquee />

  <section class="agi-section" aria-labelledby="agi-heading">
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-8 lg:grid-cols-12">
      <SectionHeading
        id="agi-heading"
        class="lg:col-span-7"
        title="Part of Aetas Global Innovation."
        lede="Aetas Global Innovation also provides AI & Automation and Managed IT services."
      />
      <div class="flex flex-col gap-3 sm:flex-row lg:col-span-5 lg:justify-end">
        <Button href="https://aetas.ai/security" variant="secondary" stretch external>Visit aetas.ai</Button>
        <Button href="https://www.aetasglobal.com/" variant="secondary" stretch external>Explore Aetas Global</Button>
      </div>
    </div>
  </section>

  <section class="agi-band agi-section" aria-labelledby="about-cta-heading">
    <SectionHeading
      id="about-cta-heading"
      align="center"
      title="Scope the security service your environment needs."
      lede="Discuss Managed Extended Detection and Response (MXDR), Network Security Testing, or Application Security Testing (Pen Testing) with our cybersecurity specialists."
    >
      <div class="mt-2 flex w-full flex-col justify-center gap-3 sm:flex-row sm:items-center">
        <Button href={demoLink.href} stretch external>{demoLink.label}</Button>
        <Button href="/contact" variant="secondary" stretch>Contact us</Button>
      </div>
    </SectionHeading>
  </section>
</Layout>
