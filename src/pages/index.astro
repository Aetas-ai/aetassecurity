---
/**
 * Homepage, structured after the reference sites (HANDOFF.md "Site
 * Structure"): hero, partners, proof metrics, why it matters, value cards,
 * services by outcome, Expert in the Loop, customer proof, certifications,
 * how engagements start, FAQ, latest resources, and a closing call to action.
 * Proof sections show slots in placeholder mode and nothing until approved.
 */
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/HomeHero.astro';
import PartnerMarquee from '../components/PartnerMarquee.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceFaqSection from '../components/ServiceFaqSection.astro';
import StatBand from '../components/StatBand.astro';
import LogoWall from '../components/LogoWall.astro';
import CustomerStories from '../components/CustomerStories.astro';
import RecognitionStrip from '../components/RecognitionStrip.astro';
import ContentSlot from '../components/ContentSlot.astro';
import PlatformDiagram from '../components/PlatformDiagram.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { breachLink, demoLink } from '../data/navigation';
import { engagementSteps, expertSteps, governance, pillars, whyItMatters } from '../data/approach';
import { homeFaqs } from '../data/service-faqs';
import { practiceStats, pricingNote, threatStats } from '../data/proof';
import { showPlaceholders } from '../data/site-flags';
import { getResources } from '../data/resources';

const latest = (await getResources()).slice(0, 3);
const showThreatStats = threatStats.length > 0 || showPlaceholders;
---

<Layout
  socialImage="home"
  title="Aetas Security | MXDR, Incident Response, and Offensive Security"
  description="Aetas Security provides Managed Extended Detection and Response (MXDR), Incident Response, Network Security Testing, and Application Security Testing (Pen Testing), guided by experienced security professionals."
>
  <HomeHero />

  <PartnerMarquee />

  <StatBand
    id="practice-stats"
    stats={practiceStats}
    todo={16}
    slotTitle="Practice metric"
    slotExpects="A real, dated figure with its definition, e.g. engagements delivered or years in practice"
  />

  <section class="section-light agi-section" aria-labelledby="why-matters-heading">
    <div class:list={['mx-auto max-w-7xl', showThreatStats ? 'problem-split' : 'grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-16']}>
      {showThreatStats ? (
        <div>
          <SectionHeading id="why-matters-heading" eyebrow="Why it matters" title={whyItMatters.title} />
          {whyItMatters.body.map((paragraph) => <p class="mt-5 max-w-xl text-lede text-muted">{paragraph}</p>)}
          <a href="/about#expert-in-the-loop" class="agi-card-link mt-8">How Expert in the Loop works</a>
        </div>
      ) : (
        // Without threat statistics, the heading and the argument share the row editorially.
        <>
          <SectionHeading id="why-matters-heading" eyebrow="Why it matters" title={whyItMatters.title} />
          <div class="lg:pt-9">
            {whyItMatters.body.map((paragraph, index) => <p class:list={['max-w-xl text-lede text-muted', index > 0 && 'mt-5']}>{paragraph}</p>)}
            <a href="/about#expert-in-the-loop" class="agi-card-link mt-8">How Expert in the Loop works</a>
          </div>
        </>
      )}
      {showThreatStats && (
        <div>
          {threatStats.length > 0 ? (
            <dl class="stat-grid">
              {threatStats.map((stat, index) => (
                <div class="stat-item">
                  <dt class="stat-label">{stat.label}<sup>{index + 1}</sup></dt>
                  <dd class="stat-value">{stat.value}</dd>
                </div>
              ))}
            </dl>
          ) : (
            <div class="stat-grid">
              {Array.from({ length: 3 }, () => (
                <ContentSlot variant="stat" title="Threat statistic" expects="A figure from a named, public report, with year and link" todo={17} />
              ))}
            </div>
          )}
          {threatStats.length > 0 && (
            <ol class="stat-notes">
              {threatStats.map((stat) => (
                <li>
                  {stat.definition}{stat.definition && ' '}
                  {stat.source && (stat.source.href ? <a href={stat.source.href} target="_blank" rel="noopener noreferrer">{stat.source.label}<span class="sr-only"> (opens in a new tab)</span></a> : stat.source.label)}
                </li>
              ))}
            </ol>
          )}
        </div>
      )}
    </div>
  </section>

  <section class="section-light-muted agi-section" aria-labelledby="why-heading">
    <div class="mx-auto max-w-7xl">
      <SectionHeading id="why-heading" title="Why Aetas Security." />
      <ul class="value-grid mt-12">
        {pillars.map(([title, body]) => (
          <li class="value-card agi-card agi-card--dark">
            <h3 class="font-display text-h3 font-semibold text-strong">{title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="agi-band agi-band--vivid agi-section" aria-labelledby="outcomes-heading">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <SectionHeading
          id="outcomes-heading"
          title="Security services for the outcome you need."
          lede="Managed detection and response, incident response, and offensive testing, with support for compliance and the controls you already run."
        />
        <a href="/services" class="agi-card-link agi-card-link--on-dark flex-none">View all services</a>
      </div>
      <PlatformDiagram />
    </div>
  </section>

  <section class="agi-band agi-section" aria-labelledby="expert-heading">
    <div class="mx-auto max-w-7xl">
      <SectionHeading
        id="expert-heading"
        eyebrow="Expert in the Loop"
        title="Human Led AI, with analysts in control."
        lede="AI helps our analysts work faster. People make the decisions that affect your systems, accounts, and users."
      />
      <ol class="agi-steps mt-12" style={`--steps: ${expertSteps.length}`}>
        {expertSteps.map(([title, body]) => (
          <li class="agi-step">
            <p class="font-display text-[0.9375rem] font-semibold text-white">{title}</p>
            <p class="mt-1 text-[0.8125rem] leading-relaxed text-muted">{body}</p>
          </li>
        ))}
      </ol>
      <ul class="governance-grid mt-8">
        {governance.map(([title, body]) => (
          <li>
            <h3 class="font-display text-base font-semibold text-white">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{body}</p>
          </li>
        ))}
      </ul>
      <ContentSlot
        class="mt-5"
        variant="inline"
        title="AI and customer data"
        expects="Confirmed answer: is customer data used to train AI models, and where is it processed?"
        todo={24}
      />
    </div>
  </section>

  <LogoWall />

  <CustomerStories band />

  <RecognitionStrip />

  <section class="agi-section" aria-labelledby="engagement-heading">
    <div class="mx-auto max-w-7xl">
      <SectionHeading id="engagement-heading" title="How engagements start." lede="Every engagement starts with a clear scope and named owners." />
      <ol class="agi-steps mt-12" style="--steps: 4">
        {engagementSteps.map(([title, body]) => (
          <li class="agi-step">
            <p class="font-display text-[0.9375rem] font-semibold text-white">{title}</p>
            <p class="mt-1 text-[0.8125rem] leading-relaxed text-muted">{body}</p>
          </li>
        ))}
      </ol>
      {pricingNote ? (
        <p class="mt-8 max-w-3xl text-[0.9375rem] leading-relaxed text-gray-300"><span class="font-semibold text-white">How engagements are priced.</span> {pricingNote}</p>
      ) : (
        <ContentSlot class="mt-5" variant="inline" title="How engagements are priced" expects="A plain-language note on pricing (scope-based, per-endpoint bands, or similar)" todo={22} />
      )}
    </div>
  </section>

  <ServiceFaqSection id="home" label="Aetas Security" items={homeFaqs} />

  {(latest.length > 0 || showPlaceholders) && (
    <section class="agi-band agi-section" aria-labelledby="latest-heading">
      <div class="mx-auto max-w-7xl">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <SectionHeading id="latest-heading" title="Latest from Resources." />
          <a href="/resources" class="agi-card-link agi-card-link--on-dark flex-none">All resources</a>
        </div>
        <ul class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-3">
          {latest.map((entry) => <li><ResourceCard entry={entry} /></li>)}
          {showPlaceholders && Array.from({ length: Math.max(0, 3 - latest.length) }, () => (
            <li><ContentSlot title="Advisory, blog post, or guide" expects="Published in src/content/resources/" todo={26} /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="agi-band agi-band--vivid agi-section" aria-labelledby="cta-heading">
    <SectionHeading
      id="cta-heading"
      align="center"
      title="Scope the security service your environment needs."
      lede="Discuss Managed Extended Detection and Response (MXDR), Incident Response, Network Security Testing, or Application Security Testing (Pen Testing) with our cybersecurity specialists."
    >
      <div class="mt-2 flex w-full flex-col justify-center gap-3 sm:flex-row sm:items-center">
        <Button href={demoLink.href} stretch external>{demoLink.label}</Button>
        <Button href="/contact" variant="secondary" stretch>Contact us</Button>
      </div>
      <a href={breachLink.href} class="agi-card-link agi-card-link--on-dark mt-4">{breachLink.label} Get help now</a>
    </SectionHeading>
  </section>
</Layout>
