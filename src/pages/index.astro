---
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/HomeHero.astro';
import PartnerMarquee from '../components/PartnerMarquee.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceFaqSection from '../components/ServiceFaqSection.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { demoLink } from '../data/navigation';
import { capabilities, services } from '../data/services';
import { engagementSteps, pillars } from '../data/approach';
import { homeFaqs } from '../data/service-faqs';

const confirmedCapabilities = capabilities.filter((capability) => capability.confirmed);
---

<Layout
  socialImage="home"
  title="Aetas Security | MXDR and Offensive Security"
  description="Aetas Security provides Managed Extended Detection and Response (MXDR), Network Security Testing, and Application Security Testing (Pen Testing), guided by experienced security professionals."
>
  <HomeHero />

  <PartnerMarquee />

  <section id="services" class="agi-section" aria-labelledby="services-heading">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <SectionHeading
          id="services-heading"
          title="Managed detection and offensive testing."
          lede="Aetas Security services are organized into Managed Extended Detection and Response (MXDR) and Offensive Security."
        />
        <a href="/services" class="agi-card-link agi-card-link--on-dark flex-none">View all services</a>
      </div>

      <ul class="mt-12 grid grid-cols-1 gap-5 lg:grid-cols-3">
        {services.map((service) => (
          <li class="agi-card agi-card--dark agi-card--interactive flex flex-col">
            <div class="flex items-center gap-3">
              <span class="nav-service-icon h-10 w-10">
                <ServiceIcon service={service.icon} class="h-[1.125rem] w-[1.125rem]" />
              </span>
              <span class="agi-eyebrow">{service.group}</span>
            </div>
            <h3 class="mt-5 font-display text-h3 font-semibold text-white">{service.shortName}</h3>
            <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-muted">{service.summary}</p>
            <a href={`/services/${service.slug}`} class="agi-card-link agi-card-link--on-dark mt-6">Explore {service.shortName}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="agi-band agi-section" aria-labelledby="why-heading">
    <div class="mx-auto max-w-7xl">
      <SectionHeading id="why-heading" title="Why Aetas Security." />
      <ul class="mt-12 grid grid-cols-1 gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
        {pillars.map(([title, body]) => (
          <li class="border-t-2 border-[var(--color-accent)] pt-5">
            <h3 class="font-display text-lg font-semibold text-white">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{body}</p>
          </li>
        ))}
      </ul>
      <a href="/about" class="agi-card-link agi-card-link--on-dark mt-10">How we work</a>
    </div>
  </section>

  <section class="agi-section" aria-labelledby="engagement-heading">
    <div class="mx-auto max-w-7xl">
      <SectionHeading id="engagement-heading" title="How engagements start." lede="Every engagement starts with a clear scope and named owners." />
      <ol class="agi-steps mt-12" style="--steps: 4">
        {engagementSteps.map(([title, body]) => (
          <li class="agi-step">
            <p class="font-display text-[0.9375rem] font-semibold text-white">{title}</p>
            <p class="mt-1 text-[0.8125rem] leading-relaxed text-muted">{body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {confirmedCapabilities.length > 0 && (
    <section class="agi-section" aria-labelledby="capabilities-heading">
      <div class="mx-auto max-w-7xl">
        <SectionHeading id="capabilities-heading" title="Protection shaped around your business." />
        <ul class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
          {confirmedCapabilities.map((capability) => (
            <li class="agi-card agi-card--dark">
              <h3 class="font-display text-lg font-semibold text-white">{capability.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{capability.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <ServiceFaqSection id="home" label="Aetas Security" items={homeFaqs} />

  <section class="agi-section" aria-labelledby="cta-heading">
    <SectionHeading
      id="cta-heading"
      align="center"
      title="Scope the security service your environment needs."
      lede="Discuss Managed Extended Detection and Response (MXDR), Network Security Testing, or Application Security Testing (Pen Testing) with our cybersecurity specialists."
    >
      <div class="mt-2 flex w-full flex-col justify-center gap-3 sm:flex-row sm:items-center">
        <Button href={demoLink.href} stretch external>{demoLink.label}</Button>
        <Button href="/contact" variant="secondary" stretch>Contact us</Button>
      </div>
    </SectionHeading>
  </section>
</Layout>
