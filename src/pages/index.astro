---
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/HomeHero.astro';
import PartnerMarquee from '../components/PartnerMarquee.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceFaqSection from '../components/ServiceFaqSection.astro';
import MxdrConsole from '../components/demos/MxdrConsole';
import { demoLink } from '../data/navigation';
import { capabilities } from '../data/services';

const mxdrSteps = [
  ['Monitor', 'Monitoring and triaging active security detections.'],
  ['Investigate', 'Investigating suspicious endpoint and identity activity.'],
  ['Respond', 'Following defined response and escalation procedures.'],
  ['Document', 'Documenting investigation and response activity.'],
];

const offensive = [
  ['network-testing', 'Network Security Testing', 'Security testing focused on network exposure, configuration weaknesses, and potential attack paths.'],
  ['application-testing', 'Application Security Testing (Pen Testing)', 'Application security testing focused on identifying and documenting security weaknesses.'],
];

const expertSteps = [
  ['AI assists', 'Human Led AI helps correlate detections, summarize activity, and recommend next steps.'],
  ['Analyst reviews', 'A security analyst validates the finding and its context.'],
  ['Analyst approves', 'Containment happens only after analyst approval, through defined escalation paths.'],
  ['Documented', 'Decisions, actions, and outcomes are recorded for your team.'],
];

const confirmedCapabilities = capabilities.filter((capability) => capability.confirmed);
---

<Layout
  socialImage="home"
  title="Aetas Security | MXDR and Offensive Security"
  description="Aetas Security, the cybersecurity practice of Aetas Global Innovation, provides Managed Extended Detection and Response (MXDR), Network Security Testing, and Application Security Testing (Pen Testing)."
>
  <HomeHero />

  <PartnerMarquee />

  <section id="services" class="agi-section" aria-labelledby="services-heading">
    <div class="mx-auto max-w-7xl">
      <SectionHeading
        id="services-heading"
        title="Managed detection and offensive testing."
        lede="Aetas Security services are organized into Managed Extended Detection and Response (MXDR) and Offensive Security."
      />

      <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-12">
        <article id="mxdr" class="agi-card agi-card--dark lg:col-span-7">
          <span class="agi-eyebrow">MXDR</span>
          <h3 class="mt-4 font-display text-h3 font-semibold text-white">Managed Extended Detection and Response (MXDR)</h3>
          <p class="mt-3 max-w-xl text-[0.9375rem] leading-relaxed text-muted">Continuous detection, investigation, response, and escalation guided by experienced security professionals.</p>
          <ol class="agi-steps mt-10" style="--steps: 4">
            {mxdrSteps.map(([title, body]) => (
              <li class="agi-step">
                <p class="font-display text-[0.9375rem] font-semibold text-white">{title}</p>
                <p class="mt-1 text-[0.8125rem] leading-relaxed text-muted">{body}</p>
              </li>
            ))}
          </ol>
        </article>

        <article id="offensive-security" class="agi-card agi-card--dark flex flex-col lg:col-span-5">
          <span class="agi-eyebrow">Offensive Security</span>
          <p class="mt-4 text-[0.9375rem] leading-relaxed text-muted">Dedicated testing engagements that evaluate network and application defenses.</p>
          <div class="mt-6 grid flex-1 gap-3">
            {offensive.map(([id, title, body]) => (
              <div id={id} class="border-l-2 border-[var(--color-accent)] bg-[rgba(143,211,242,0.03)] py-4 pl-5 pr-4">
                <h3 class="font-display text-lg font-semibold text-white">{title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{body}</p>
              </div>
            ))}
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="agi-band agi-section" aria-labelledby="coverage-heading">
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-start gap-12 lg:grid-cols-12">
      <SectionHeading
        id="coverage-heading"
        class="lg:sticky lg:top-28 lg:col-span-4"
        title="Focused coverage across detection, response, and testing."
        lede="MXDR supports ongoing security monitoring and response, while Offensive Security evaluates network and application defenses through dedicated testing engagements."
      />
      <div class="lg:col-span-8">
        <MxdrConsole client:visible />
      </div>
    </div>
  </section>

  <section id="expert-in-the-loop" class="agi-section" aria-labelledby="expert-heading">
    <div class="mx-auto max-w-7xl">
      <SectionHeading
        id="expert-heading"
        eyebrow="Expert in the Loop"
        title="AI-assisted detection, with experts in control."
        lede="Aetas Security applies Human Led AI to help detect and prioritize threats, with Expert Human Oversight of AI (Expert in the Loop). AI supports the analyst; it does not act on your environment by itself."
      />
      <ol class="agi-steps mt-12" style="--steps: 4">
        {expertSteps.map(([title, body]) => (
          <li class="agi-step">
            <p class="font-display text-[0.9375rem] font-semibold text-white">{title}</p>
            <p class="mt-1 text-[0.8125rem] leading-relaxed text-muted">{body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {confirmedCapabilities.length > 0 && (
    <section class="agi-section" aria-labelledby="capabilities-heading">
      <div class="mx-auto max-w-7xl">
        <SectionHeading id="capabilities-heading" title="Protection shaped around your business." />
        <ul class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
          {confirmedCapabilities.map((capability) => (
            <li class="agi-card agi-card--dark">
              <h3 class="font-display text-lg font-semibold text-white">{capability.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{capability.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <ServiceFaqSection service="security" label="Aetas Security" accent="security" />

  <section class="agi-section" aria-labelledby="agi-heading">
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-8 lg:grid-cols-12">
      <SectionHeading
        id="agi-heading"
        class="lg:col-span-7"
        title="Beyond cybersecurity."
        lede="Aetas Global Innovation also provides AI & Automation and Managed IT services."
      />
      <div class="flex flex-col gap-3 sm:flex-row lg:col-span-5 lg:justify-end">
        <Button href="https://aetas.ai/security" variant="secondary" stretch external>Visit aetas.ai</Button>
        <Button href="https://www.aetasglobal.com/" variant="secondary" stretch external>Explore Aetas Global</Button>
      </div>
    </div>
  </section>

  <section class="agi-band agi-section" aria-labelledby="cta-heading">
    <SectionHeading
      id="cta-heading"
      align="center"
      title="Scope the security service your environment needs."
      lede="Discuss Managed Extended Detection and Response (MXDR), Network Security Testing, or Application Security Testing (Pen Testing) with our cybersecurity specialists."
    >
      <div class="mt-2 flex w-full flex-col justify-center gap-3 sm:flex-row sm:items-center">
        <Button href={demoLink.href} stretch external>{demoLink.label}</Button>
        <Button href="/contact" variant="secondary" stretch>Contact us</Button>
      </div>
    </SectionHeading>
  </section>
</Layout>
