---
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/HomeHero.astro';
import PartnerMarquee from '../components/PartnerMarquee.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceFaqSection from '../components/ServiceFaqSection.astro';
import CapabilitiesSection from '../components/CapabilitiesSection.astro';
import { demoLink } from '../data/navigation';
import { engagementSteps, pillars } from '../data/approach';
import { homeFaqs } from '../data/service-faqs';

---

<Layout
  socialImage="home"
  title="Aetas Security | MXDR and Offensive Security"
  description="Aetas Security provides Managed Extended Detection and Response (MXDR), Network Security Testing, and Application Security Testing (Pen Testing), guided by experienced security professionals."
>
  <HomeHero />

  <PartnerMarquee />

  <CapabilitiesSection />

  <section class="agi-band agi-section" aria-labelledby="why-heading">
    <div class="mx-auto max-w-7xl">
      <SectionHeading id="why-heading" title="Why Aetas Security." />
      <ul class="mt-12 grid grid-cols-1 gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
        {pillars.map(([title, body]) => (
          <li class="border-t-2 border-[var(--color-accent)] pt-5">
            <h3 class="font-display text-lg font-semibold text-white">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{body}</p>
          </li>
        ))}
      </ul>
      <a href="/about" class="agi-card-link agi-card-link--on-dark mt-10">How we work</a>
    </div>
  </section>

  <section class="agi-section" aria-labelledby="engagement-heading">
    <div class="mx-auto max-w-7xl">
      <SectionHeading id="engagement-heading" title="How engagements start." lede="Every engagement starts with a clear scope and named owners." />
      <ol class="agi-steps mt-12" style="--steps: 4">
        {engagementSteps.map(([title, body]) => (
          <li class="agi-step">
            <p class="font-display text-[0.9375rem] font-semibold text-white">{title}</p>
            <p class="mt-1 text-[0.8125rem] leading-relaxed text-muted">{body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <ServiceFaqSection id="home" label="Aetas Security" items={homeFaqs} />

  <section class="agi-section" aria-labelledby="cta-heading">
    <SectionHeading
      id="cta-heading"
      align="center"
      title="Scope the security service your environment needs."
      lede="Discuss Managed Extended Detection and Response (MXDR), Network Security Testing, or Application Security Testing (Pen Testing) with our cybersecurity specialists."
    >
      <div class="mt-2 flex w-full flex-col justify-center gap-3 sm:flex-row sm:items-center">
        <Button href={demoLink.href} stretch external>{demoLink.label}</Button>
        <Button href="/contact" variant="secondary" stretch>Contact us</Button>
      </div>
    </SectionHeading>
  </section>
</Layout>
