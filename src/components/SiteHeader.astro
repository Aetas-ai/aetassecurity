---
/**
 * Fixed site header: logo, Services mega menu (disclosure pattern), primary
 * links, and the Request a demo CTA (external booking page). Behaviour lives
 * in src/scripts/site-nav.ts.
 */
import ServiceIcon from './ServiceIcon.astro';
import { demoLink, isActivePath, isServicesPath, primaryNav, serviceNav, servicesHubLink } from '../data/navigation';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const servicesActive = isServicesPath(currentPath);
---

<header class="site-header fixed inset-x-0 top-0 z-50">
  <div class="site-header-row mx-auto flex h-[var(--site-header-height)] max-w-7xl items-center gap-6 px-4 sm:px-6">
    <a href="/" class="site-header-logo" aria-label="Aetas Security home">
      <img src="/logo.png" alt="Aetas Security" width="865" height="176" class="h-full w-full object-contain object-left" decoding="async" />
    </a>

    <nav class="site-nav hidden flex-1 justify-center lg:flex" aria-label="Primary navigation">
      <ul class="flex items-center gap-0.5">
        <li class="nav-dropdown" data-nav-dropdown>
          <button
            type="button"
            class="site-nav-link site-nav-trigger"
            aria-expanded="false"
            aria-controls="services-menu"
            data-nav-trigger
            data-active={servicesActive ? '' : undefined}
          >
            Services
            <svg class="site-nav-chevron" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
              <path d="M3 4.5 6 7.5l3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>

          <div id="services-menu" class="nav-panel" data-nav-panel>
            <div class="nav-panel-surface">
              <ul class="nav-panel-grid">
                {serviceNav.map((service) => (
                  <li class="nav-service" data-nav-column>
                    <a href={service.href} class="nav-service-head">
                      <span class="nav-service-icon">
                        <ServiceIcon service={service.key} class="h-[1.125rem] w-[1.125rem]" />
                      </span>
                      <span class="min-w-0">
                        <span class="nav-service-title">{service.label}</span>
                        <span class="nav-service-tag">{service.tag}</span>
                      </span>
                    </a>
                    <p class="nav-service-blurb">{service.blurb}</p>
                    <ul class="nav-service-list">
                      {service.capabilities.map((capability) => (
                        <li>
                          <a href={capability.href} class="nav-capability">
                            <span class="nav-capability-label">{capability.label}</span>
                            {capability.hint && <span class="nav-capability-hint">{capability.hint}</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </li>
                ))}
              </ul>
              <div class="nav-panel-foot" data-nav-column>
                <p>Not sure which service fits your need?</p>
                <a href={servicesHubLink.href} class="nav-panel-foot-link" aria-current={currentPath === servicesHubLink.href ? 'page' : undefined}>{servicesHubLink.label}</a>
              </div>
            </div>
          </div>
        </li>

        {primaryNav.map((link) => (
          <li>
            <a href={link.href} class="site-nav-link" aria-current={isActivePath(currentPath, link.href) ? 'page' : undefined}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2 lg:ml-0">
      <a href={demoLink.href} class="site-header-cta hidden lg:inline-flex" target="_blank" rel="noopener noreferrer">
        {demoLink.label}
        <span aria-hidden="true">↗</span>
        <span class="sr-only">(opens in a new tab)</span>
      </a>

      <button
        id="mobile-menu-btn"
        type="button"
        class="site-menu-button lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true" focusable="false">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
