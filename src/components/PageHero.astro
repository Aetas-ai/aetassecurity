---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from './Button.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import NetworkBackdrop from './NetworkBackdrop.astro';
import HeroAtmosphere from './HeroAtmosphere.astro';

interface Props {
  /** Optional trail rendered above the eyebrow (current page last). */
  breadcrumbs?: { label: string; href: string }[];
  eyebrow?: string;
  title: string;
  description: string;
  accent?: 'ai' | 'security' | 'global' | 'neutral';
  image?: ImageMetadata;
  imageAlt?: string;
  primaryLabel?: string;
  primaryHref?: string;
  /** Opens the primary link in a new tab (the external booking page). */
  primaryExternal?: boolean;
  secondaryLabel?: string;
  secondaryHref?: string;
  /** Opens the secondary link in a new tab (for sister sites). */
  secondaryExternal?: boolean;
  focusLabel?: string;
  focusItems?: string[];
  compact?: boolean;
}

const {
  breadcrumbs,
  eyebrow,
  title,
  description,
  accent = 'neutral',
  image,
  imageAlt = '',
  primaryLabel,
  primaryHref,
  primaryExternal = false,
  secondaryLabel,
  secondaryHref,
  secondaryExternal = false,
  focusLabel = 'Service focus',
  focusItems = [],
  compact = false,
} = Astro.props;

const accentClass = accent === 'neutral' ? undefined : `accent-${accent}`;
// A named `aside` slot (service diagrams) replaces the focus list in the right column.
const hasAside = Astro.slots.has('aside');
const twoColumn = hasAside || focusItems.length > 0;
const heroId = `page-hero-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`;
---

<section
  class:list={[
    'page-hero relative isolate flex items-center overflow-hidden border-b border-white/5 bg-brand-bg px-6',
    compact ? 'min-h-[360px] py-14 sm:min-h-[400px] sm:py-16' : 'page-hero-full py-14 sm:py-16 lg:py-20',
  ]}
  aria-labelledby={heroId}
>
  {image ? (
    <div class="absolute inset-0 -z-20">
      <Image src={image} alt={imageAlt} widths={[640, 960, 1440]} sizes="100vw" class="h-full w-full object-cover object-center brightness-[0.3] saturate-[0.72] scale-[1.01]" loading="eager" decoding="async" fetchpriority="high" />
    </div>
  ) : (
    <div class:list={['page-hero-light pointer-events-none absolute inset-0 -z-10', accentClass]} aria-hidden="true"></div>
  )}

  {!image && <HeroAtmosphere variant="soft" />}
  <NetworkBackdrop trace={!hasAside} />
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(100deg,#050b16_0%,rgba(5,11,22,0.9)_40%,rgba(5,11,22,0.45)_70%,rgba(5,11,22,0.15)_100%)] max-xl:bg-[linear-gradient(180deg,rgba(5,11,22,0.82)_0%,#050b16_96%)]" aria-hidden="true"></div>

  <div class:list={['page-hero-shell mx-auto grid min-w-0 w-full max-w-7xl items-center gap-12', hasAside ? 'lg:grid-cols-[minmax(0,1.1fr)_minmax(300px,0.9fr)] lg:gap-14' : twoColumn ? 'xl:grid-cols-[minmax(0,1.15fr)_minmax(320px,0.85fr)] xl:gap-16' : '']}>
    <div class:list={['agi-hero-enter flex min-w-0 max-w-3xl flex-col items-start gap-5 sm:gap-6', accentClass]}>
      {breadcrumbs && breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} class="-mb-1" />}
      {eyebrow && <span class="agi-eyebrow">{eyebrow}</span>}

      <h1 id={heroId} class="page-hero-title agi-heading-fade max-w-full font-display text-display font-semibold [overflow-wrap:anywhere]">
        {title}
      </h1>

      <p class="max-w-2xl text-lede text-gray-300">
        {description}
      </p>

      {(primaryLabel && primaryHref) || (secondaryLabel && secondaryHref) ? (
        <div class="flex w-full flex-col gap-3 pt-2 sm:w-auto sm:flex-row sm:items-center">
          {primaryLabel && primaryHref ? (
            <Button href={primaryHref} accent={accent} external={primaryExternal} stretch>{primaryLabel}</Button>
          ) : null}
          {secondaryLabel && secondaryHref ? (
            <Button href={secondaryHref} variant="secondary" stretch external={secondaryExternal}>{secondaryLabel}</Button>
          ) : null}
        </div>
      ) : null}

      <slot />
    </div>

    {hasAside ? (
      <div class="agi-hero-focus min-w-0">
        <slot name="aside" />
      </div>
    ) : focusItems.length > 0 ? (
      <div class:list={['agi-hero-focus hidden xl:block', accentClass]} aria-label={`${focusLabel}`}>
        <div class="border-l border-[color-mix(in_srgb,var(--accent,#fff)_28%,transparent)] pl-8">
          <span class="agi-eyebrow">{focusLabel}</span>
          <ol class="mt-6 space-y-0">
            {focusItems.map((item, index) => (
              <li class="flex min-h-16 items-center gap-5 border-t border-white/10 py-4 last:border-b">
                <span class="font-display text-xs font-bold text-[var(--accent-text,#d0d3d8)]">0{index + 1}</span>
                <span class="text-sm font-semibold text-white">{item}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    ) : null}
  </div>

  <div class:list={['pointer-events-none absolute inset-x-0 bottom-0 h-px bg-[var(--accent,rgba(255,255,255,0.6))]', accentClass]} aria-hidden="true"></div>
</section>

<style>
  /* Heroes without a background image get restrained accent light instead. */
  .page-hero-light {
    background:
      radial-gradient(44rem 28rem at 82% 30%, color-mix(in srgb, var(--accent, var(--color-ai)) 13%, transparent), transparent 70%),
      radial-gradient(30rem 20rem at 8% 0%, color-mix(in srgb, var(--accent, var(--color-ai)) 6%, transparent), transparent 70%);
  }

  .agi-hero-focus {
    animation: agi-hero-focus-in 720ms var(--ease-out-expo) 120ms both;
  }

  @keyframes agi-hero-focus-in {
    from { transform: translate3d(18px, 0, 0); }
  }

  .page-hero-full {
    min-height: calc(100vh - var(--site-header-height));
    min-height: calc(100dvh - var(--site-header-height));
  }

  /* Short laptop screens: matches the global.css short-screen tokens. */
  @media (min-width: 1024px) and (max-height: 900px) {
    .page-hero {
      padding-top: 2.5rem;
      padding-bottom: 2.5rem;
    }

    .page-hero-title {
      font-size: min(var(--text-display), 3rem);
    }
  }
</style>
