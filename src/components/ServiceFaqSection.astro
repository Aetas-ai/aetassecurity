---
/** FAQ band (with FAQPage structured data) for the homepage and each service page. */
import Faq from './Faq.astro';
import SectionHeading from './SectionHeading.astro';
import type { FaqItem } from '../data/service-faqs';

interface Props {
  id: string;
  label: string;
  items: FaqItem[];
}

const { id, label, items } = Astro.props;
const headingId = `faq-${id}`;
---

<section class="agi-band agi-section" aria-labelledby={headingId}>
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 lg:grid-cols-12">
    <SectionHeading id={headingId} class="lg:col-span-4" title={`Questions about ${label}.`} />
    <div class="lg:col-span-8">
      <Faq items={items} />
    </div>
  </div>
</section>
