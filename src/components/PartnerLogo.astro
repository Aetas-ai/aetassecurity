---
/**
 * Renders one approved partner mark at a given height, keeping its
 * proportions. Decorative by default; pass `labelled` when the logo is the
 * only content of a link so assistive tech gets the partner name.
 */
import type { PartnerLogo } from '../data/partner-logos';

interface Props {
  logo: PartnerLogo;
  /** CSS height, e.g. "1.75rem". */
  height: string;
  labelled?: boolean;
  class?: string;
}

const { logo, height, labelled = false, class: className } = Astro.props;
---

<img
  class={className}
  src={logo.src}
  alt={labelled ? logo.name : ''}
  width={logo.width}
  height={logo.height}
  style={`height: ${height}; width: auto`}
  loading="lazy"
  decoding="async"
/>
