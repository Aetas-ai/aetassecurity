---
/**
 * Homepage hero visual: a code-drawn particle globe (src/scripts/hero-globe.ts)
 * with the line-drawn shield at its centre and orbit rings around it.
 * Detections travel Detected → Analyst approval → Contained. Decorative
 * (aria-hidden); the sequence it shows is described in the surrounding copy.
 */
import ShieldMark from './ShieldMark.astro';
---

<div class="hero-globe" aria-hidden="true" data-hero-globe data-motion>
  <div class="hero-globe-stage" data-globe-stage>
    <svg class="hero-globe-orbits" viewBox="0 0 400 400" focusable="false">
      <ellipse cx="200" cy="200" rx="188" ry="62" />
      <ellipse cx="200" cy="200" rx="176" ry="118" />
      <circle cx="200" cy="200" r="194" />
    </svg>
    <canvas></canvas>
    <ShieldMark class="hero-globe-shield" />
    <div class="hero-globe-chips" data-globe-chips></div>
  </div>
</div>

<style>
  .hero-globe {
    position: relative;
    width: 100%;
    max-width: 38rem;
    margin-inline: auto;
    perspective: 1200px;
  }

  .hero-globe-stage {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .hero-globe canvas {
    position: absolute;
    inset: 0;
    display: block;
  }

  .hero-globe-orbits {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: rgba(143, 211, 242, 0.14);
    stroke-width: 1;
  }

  .hero-globe-orbits ellipse:first-child {
    stroke: rgba(34, 211, 238, 0.28);
    stroke-dasharray: 2 6;
  }

  :global(.hero-globe-shield) {
    position: absolute;
    top: 50%;
    left: 50%;
    height: 24%;
    transform: translate(-50%, -54%);
  }

  .hero-globe-chips {
    position: absolute;
    inset: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-globe-orbits {
      animation: orbit-turn 60s linear infinite;
      transform-origin: center;
    }
  }

  @keyframes orbit-turn {
    to { transform: rotate(360deg); }
  }
</style>
