---
/**
 * Hero radar: the site's one orchestrated motion moment. The sweep passes a
 * blip, which shows as detected, waits for analyst review, then turns
 * contained, acting out Expert in the Loop (no containment without analyst
 * approval). Decorative SVG; the legend carries the meaning in text.
 * Pauses off-screen (data-motion) and is static under reduced motion.
 */
const SWEEP_SECONDS = 9;

// Angles are clockwise from 12 o'clock; each blip lights up as the sweep passes it.
const blips = [
  { angle: 38, radius: 128, state: 'contained' },
  { angle: 104, radius: 74, state: 'review' },
  { angle: 162, radius: 150, state: 'contained' },
  { angle: 228, radius: 104, state: 'detected' },
  { angle: 296, radius: 140, state: 'contained' },
  { angle: 334, radius: 60, state: 'review' },
].map((blip) => {
  const radians = ((blip.angle - 90) * Math.PI) / 180;
  return {
    ...blip,
    x: +(200 + blip.radius * Math.cos(radians)).toFixed(1),
    y: +(200 + blip.radius * Math.sin(radians)).toFixed(1),
    delay: `${((blip.angle / 360) * SWEEP_SECONDS).toFixed(2)}s`,
  };
});
---

<figure class="threat-radar" data-motion style={`--sweep: ${SWEEP_SECONDS}s`}>
  <div class="threat-radar-frame">
    <svg viewBox="0 0 400 400" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="radar-sweep-fill" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#2f6bff" stop-opacity="0" />
          <stop offset="1" stop-color="#22d3ee" stop-opacity="0.32" />
        </linearGradient>
        <radialGradient id="radar-floor" cx="0.5" cy="0.5" r="0.5">
          <stop offset="0" stop-color="#3aaee0" stop-opacity="0.1" />
          <stop offset="1" stop-color="#3aaee0" stop-opacity="0" />
        </radialGradient>
      </defs>

      <circle cx="200" cy="200" r="184" fill="url(#radar-floor)" />
      <g class="threat-radar-grid">
        <circle cx="200" cy="200" r="184" />
        <circle cx="200" cy="200" r="138" />
        <circle cx="200" cy="200" r="92" />
        <circle cx="200" cy="200" r="46" />
        <line x1="200" y1="12" x2="200" y2="388" />
        <line x1="12" y1="200" x2="388" y2="200" />
      </g>

      <g class="threat-radar-sweep">
        <path d="M200 200 L200 16 A184 184 0 0 1 292 40.6 Z" fill="url(#radar-sweep-fill)" />
        <line x1="200" y1="200" x2="292" y2="40.6" class="threat-radar-beam" />
      </g>

      {blips.map((blip) => (
        <g class:list={['threat-radar-blip', `is-${blip.state}`]} style={`animation-delay: ${blip.delay}`}>
          <circle class="threat-radar-ring" cx={blip.x} cy={blip.y} r="11" style={`animation-delay: ${blip.delay}; transform-origin: ${blip.x}px ${blip.y}px`} />
          <circle class="threat-radar-dot" cx={blip.x} cy={blip.y} r="4.5" style={`animation-delay: ${blip.delay}`} />
        </g>
      ))}

      <image href="/icon.png" x="176" y="176" width="48" height="48" />
    </svg>
  </div>

  <figcaption class="threat-radar-legend">
    <ul>
      <li><span class="threat-radar-key is-detected" aria-hidden="true"></span>Detected</li>
      <li><span class="threat-radar-key is-review" aria-hidden="true"></span>Analyst review</li>
      <li><span class="threat-radar-key is-contained" aria-hidden="true"></span>Contained after approval</li>
    </ul>
  </figcaption>
</figure>

<style>
  .threat-radar {
    --detected: var(--color-detected);
    --review: var(--color-review);
    --contained: var(--color-accent);
    display: flex;
    width: min(100%, 30rem);
    flex-direction: column;
    gap: 1.25rem;
    margin-inline: auto;
  }

  /* Reticle corners, matching the demo window frame. */
  .threat-radar-frame {
    position: relative;
    aspect-ratio: 1;
    padding: 0.75rem;
  }

  .threat-radar-frame::before,
  .threat-radar-frame::after {
    position: absolute;
    width: 1.5rem;
    height: 1.5rem;
    border: 0 solid var(--color-accent);
    content: '';
  }

  .threat-radar-frame::before {
    top: 0;
    left: 0;
    border-width: 2px 0 0 2px;
  }

  .threat-radar-frame::after {
    right: 0;
    bottom: 0;
    border-width: 0 2px 2px 0;
  }

  .threat-radar svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .threat-radar-grid {
    fill: none;
    stroke: rgba(143, 211, 242, 0.14);
    stroke-width: 1;
  }

  .threat-radar-beam {
    stroke: #22d3ee;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .threat-radar-sweep {
    transform-box: view-box;
    transform-origin: 200px 200px;
    animation: radar-sweep var(--sweep) linear infinite;
  }

  /* Static state (reduced motion, or before the sweep reaches a blip). */
  .threat-radar-dot { fill: var(--state); }
  .threat-radar-ring { fill: none; stroke: var(--state); stroke-width: 1.25; opacity: 0.55; }
  .is-detected { --state: var(--detected); }
  .is-review { --state: var(--review); }
  .is-contained { --state: var(--contained); }

  @media (prefers-reduced-motion: no-preference) {
    .threat-radar-dot {
      opacity: 0;
      animation: radar-blip var(--sweep) linear infinite;
    }

    .threat-radar-ring {
      opacity: 0;
      animation: radar-ring var(--sweep) linear infinite;
    }
  }

  @keyframes radar-sweep {
    to { transform: rotate(360deg); }
  }

  /* One sweep: detected on contact, held for analyst review, then contained. */
  @keyframes radar-blip {
    0% { opacity: 0; fill: var(--detected); }
    2%, 22% { opacity: 1; fill: var(--detected); }
    26%, 50% { opacity: 1; fill: var(--review); }
    54%, 84% { opacity: 1; fill: var(--contained); }
    96%, 100% { opacity: 0; fill: var(--contained); }
  }

  @keyframes radar-ring {
    0%, 24% { opacity: 0; stroke: var(--review); transform: scale(0.6); }
    30% { opacity: 0.8; stroke: var(--review); transform: scale(1); }
    38% { opacity: 0.2; stroke: var(--review); transform: scale(1.5); }
    44% { opacity: 0.8; stroke: var(--review); transform: scale(1); }
    52% { opacity: 0.6; stroke: var(--contained); transform: scale(1); }
    84% { opacity: 0.6; stroke: var(--contained); transform: scale(1); }
    96%, 100% { opacity: 0; stroke: var(--contained); transform: scale(1); }
  }

  .threat-radar[data-motion-paused] * {
    animation-play-state: paused;
  }

  .threat-radar-legend ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.25rem;
    color: var(--color-gray-400);
    font-size: 0.8125rem;
  }

  .threat-radar-legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .threat-radar-key {
    width: 0.625rem;
    height: 0.625rem;
    background: var(--state);
    clip-path: polygon(0.2rem 0, 100% 0, 100% calc(100% - 0.2rem), calc(100% - 0.2rem) 100%, 0 100%, 0 0.2rem);
  }

  /* Short laptops: keep the hero headline and CTA above the fold. */
  @media (min-width: 1024px) and (max-height: 900px) {
    .threat-radar {
      width: min(100%, 30rem, calc(100dvh - var(--site-header-height) - 9rem));
    }
  }
</style>
