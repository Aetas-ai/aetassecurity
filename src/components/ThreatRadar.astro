---
/**
 * Hero radar: the site's one orchestrated motion moment. The sweep passes a
 * blip, which shows as detected, waits for analyst review, then turns
 * contained, acting out Expert in the Loop (no containment without analyst
 * approval). Decorative; the legend carries the meaning in text.
 * The grid is a static SVG; the sweep and blips are HTML layers animating
 * transform and opacity only, so they run on the compositor instead of
 * repainting the SVG every frame. Pauses off-screen (data-motion) and is
 * static under reduced motion.
 */
const SWEEP_SECONDS = 9;

// Angles are clockwise from 12 o'clock; each blip lights up as the sweep passes it.
const blips = [
  { angle: 38, radius: 128, state: 'contained' },
  { angle: 104, radius: 74, state: 'review' },
  { angle: 162, radius: 150, state: 'contained' },
  { angle: 228, radius: 104, state: 'detected' },
  { angle: 296, radius: 140, state: 'contained' },
  { angle: 334, radius: 60, state: 'review' },
].map((blip) => {
  const radians = ((blip.angle - 90) * Math.PI) / 180;
  return {
    ...blip,
    // Position as a percentage of the 400×400 drawing.
    x: +((200 + blip.radius * Math.cos(radians)) / 4).toFixed(2),
    y: +((200 + blip.radius * Math.sin(radians)) / 4).toFixed(2),
    delay: `${((blip.angle / 360) * SWEEP_SECONDS).toFixed(2)}s`,
  };
});
---

<figure class="threat-radar" data-motion style={`--sweep: ${SWEEP_SECONDS}s`}>
  <div class="threat-radar-frame">
    <svg viewBox="0 0 400 400" aria-hidden="true" focusable="false">
      <defs>
        <radialGradient id="radar-floor" cx="0.5" cy="0.5" r="0.5">
          <stop offset="0" stop-color="#3aaee0" stop-opacity="0.1" />
          <stop offset="1" stop-color="#3aaee0" stop-opacity="0" />
        </radialGradient>
      </defs>

      <circle cx="200" cy="200" r="184" fill="url(#radar-floor)" />
      <g class="threat-radar-grid">
        <circle cx="200" cy="200" r="184" />
        <circle cx="200" cy="200" r="138" />
        <circle cx="200" cy="200" r="92" />
        <circle cx="200" cy="200" r="46" />
        <line x1="200" y1="12" x2="200" y2="388" />
        <line x1="12" y1="200" x2="388" y2="200" />
      </g>

      <image href="/icon.png" x="176" y="176" width="48" height="48" />
    </svg>

    <div class="threat-radar-layer" aria-hidden="true">
      <span class="threat-radar-sweep"></span>
      {blips.map((blip) => (
        <span class:list={['threat-radar-blip', `is-${blip.state}`]} style={`left: ${blip.x}%; top: ${blip.y}%; --delay: ${blip.delay}`}>
          <span class="threat-radar-ring threat-radar-ring--review"></span>
          <span class="threat-radar-ring threat-radar-ring--contained"></span>
          <span class="threat-radar-dot threat-radar-dot--detected"></span>
          <span class="threat-radar-dot threat-radar-dot--review"></span>
          <span class="threat-radar-dot threat-radar-dot--contained"></span>
        </span>
      ))}
    </div>
  </div>

  <figcaption class="threat-radar-legend">
    <ul>
      <li><span class="threat-radar-key is-detected" aria-hidden="true"></span>Detected</li>
      <li><span class="threat-radar-key is-review" aria-hidden="true"></span>Analyst review</li>
      <li><span class="threat-radar-key is-contained" aria-hidden="true"></span>Contained after approval</li>
    </ul>
  </figcaption>
</figure>

<style>
  .threat-radar {
    --detected: var(--color-detected);
    --review: var(--color-review);
    --contained: var(--color-accent);
    display: flex;
    width: min(100%, 30rem);
    flex-direction: column;
    gap: 1.25rem;
    margin-inline: auto;
  }

  /* Reticle corners, matching the demo window frame. */
  .threat-radar-frame {
    position: relative;
    aspect-ratio: 1;
    padding: 0.75rem;
  }

  .threat-radar-frame::before,
  .threat-radar-frame::after {
    position: absolute;
    width: 1.5rem;
    height: 1.5rem;
    border: 0 solid var(--color-accent);
    content: '';
  }

  .threat-radar-frame::before {
    top: 0;
    left: 0;
    border-width: 2px 0 0 2px;
  }

  .threat-radar-frame::after {
    right: 0;
    bottom: 0;
    border-width: 0 2px 2px 0;
  }

  .threat-radar svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .threat-radar-grid {
    fill: none;
    stroke: rgba(143, 211, 242, 0.14);
    stroke-width: 1;
  }

  /* The moving parts sit over the SVG's drawing area (the frame's padding box). */
  .threat-radar-layer {
    position: absolute;
    inset: 0.75rem;
  }

  /* Sweep: a 30° conic wedge (blue fading to cyan) plus its leading beam. */
  .threat-radar-sweep {
    position: absolute;
    top: 4%;
    left: 4%;
    width: 92%;
    height: 92%;
    border-radius: 9999px;
    background: conic-gradient(from 0deg, rgba(47, 107, 255, 0) 0deg, rgba(34, 211, 238, 0.32) 30deg, transparent 30deg);
    will-change: transform;
  }

  .threat-radar-sweep::after {
    position: absolute;
    top: 0;
    left: calc(50% - 0.75px);
    width: 1.5px;
    height: 50%;
    border-radius: 9999px;
    background: #22d3ee;
    content: '';
    transform: rotate(30deg);
    transform-origin: 50% 100%;
  }

  .threat-radar-blip {
    position: absolute;
    width: 5.5%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
  }

  .threat-radar-dot,
  .threat-radar-ring {
    position: absolute;
    border-radius: 9999px;
    opacity: 0;
  }

  .threat-radar-dot {
    inset: 29%;
  }

  .threat-radar-ring {
    inset: 0;
    border: 1.25px solid;
  }

  .threat-radar-dot--detected { background: var(--detected); }
  .threat-radar-dot--review { background: var(--review); }
  .threat-radar-dot--contained { background: var(--contained); }
  .threat-radar-ring--review { border-color: var(--review); }
  .threat-radar-ring--contained { border-color: var(--contained); }

  /* Static state (reduced motion): each blip shows its own stage. */
  .is-detected .threat-radar-dot--detected,
  .is-review .threat-radar-dot--review,
  .is-contained .threat-radar-dot--contained { opacity: 1; }
  .is-review .threat-radar-ring--review,
  .is-contained .threat-radar-ring--contained { opacity: 0.55; }

  .is-detected { --state: var(--detected); }
  .is-review { --state: var(--review); }
  .is-contained { --state: var(--contained); }

  @media (prefers-reduced-motion: no-preference) {
    .threat-radar-sweep {
      animation: radar-sweep var(--sweep) linear infinite;
    }

    .threat-radar-blip .threat-radar-dot,
    .threat-radar-blip .threat-radar-ring {
      opacity: 0;
      animation: var(--sweep) linear var(--delay) infinite both;
      will-change: opacity, transform;
    }

    .threat-radar-blip .threat-radar-dot--detected { animation-name: radar-detected; }
    .threat-radar-blip .threat-radar-dot--review { animation-name: radar-review; }
    .threat-radar-blip .threat-radar-dot--contained { animation-name: radar-contained; }
    .threat-radar-blip .threat-radar-ring--review { animation-name: radar-ring-review; }
    .threat-radar-blip .threat-radar-ring--contained { animation-name: radar-ring-contained; }
  }

  @keyframes radar-sweep {
    to { transform: rotate(360deg); }
  }

  /* One sweep: detected on contact, held for analyst review, then contained. */
  @keyframes radar-detected {
    0% { opacity: 0; }
    2%, 22% { opacity: 1; }
    26%, 100% { opacity: 0; }
  }

  @keyframes radar-review {
    0%, 22% { opacity: 0; }
    26%, 50% { opacity: 1; }
    54%, 100% { opacity: 0; }
  }

  @keyframes radar-contained {
    0%, 50% { opacity: 0; }
    54%, 84% { opacity: 1; }
    96%, 100% { opacity: 0; }
  }

  @keyframes radar-ring-review {
    0%, 24% { opacity: 0; transform: scale(0.6); }
    30% { opacity: 0.8; transform: scale(1); }
    38% { opacity: 0.2; transform: scale(1.5); }
    44% { opacity: 0.8; transform: scale(1); }
    52%, 100% { opacity: 0; transform: scale(1); }
  }

  @keyframes radar-ring-contained {
    0%, 50% { opacity: 0; }
    52%, 84% { opacity: 0.6; }
    96%, 100% { opacity: 0; }
  }

  .threat-radar[data-motion-paused] * {
    animation-play-state: paused;
  }

  .threat-radar-legend ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.25rem;
    color: var(--color-gray-400);
    font-size: 0.8125rem;
  }

  .threat-radar-legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .threat-radar-key {
    width: 0.625rem;
    height: 0.625rem;
    background: var(--state);
    clip-path: polygon(0.2rem 0, 100% 0, 100% calc(100% - 0.2rem), calc(100% - 0.2rem) 100%, 0 100%, 0 0.2rem);
  }

  /* Short laptops: keep the hero headline and CTA above the fold. */
  @media (min-width: 1024px) and (max-height: 900px) {
    .threat-radar {
      width: min(100%, 30rem, calc(100dvh - var(--site-header-height) - 9rem));
    }
  }
</style>
