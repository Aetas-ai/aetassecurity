---
/**
 * A licensed photo (src/assets/photos/CREDITS.md) in the site's frame: the
 * shield's cut corners, reticle brackets, and a faint royal-blue tint so any
 * stock image sits in the brand palette. Decorative by default (alt="").
 * Astro generates responsive WebP sizes at build.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt?: string;
  /** Rendered width hint for responsive sizes, e.g. "(min-width: 1024px) 40vw, 100vw". */
  sizes: string;
  /** CSS aspect ratio of the frame. */
  aspect?: string;
  class?: string;
}

const { src, alt = '', sizes, aspect = '4 / 3', class: className } = Astro.props;
---

<figure class:list={['photo-frame', className]} style={`--photo-aspect: ${aspect}`}>
  <div class="photo-frame-crop">
    <Image src={src} alt={alt} widths={[480, 800, 1200, 1600]} sizes={sizes} loading="lazy" decoding="async" />
  </div>
</figure>

<style>
  .photo-frame {
    position: relative;
    padding: 0.625rem;
  }

  /* Reticle corners, matching the radar, diagrams, and demo window. */
  .photo-frame::before,
  .photo-frame::after {
    position: absolute;
    width: 1.5rem;
    height: 1.5rem;
    border: 0 solid var(--color-accent);
    content: '';
  }

  .photo-frame::before {
    top: 0;
    left: 0;
    border-width: 2px 0 0 2px;
  }

  .photo-frame::after {
    right: 0;
    bottom: 0;
    border-width: 0 2px 2px 0;
  }

  .photo-frame-crop {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--photo-aspect);
    clip-path: polygon(var(--cut) 0, 100% 0, 100% calc(100% - var(--cut)), calc(100% - var(--cut)) 100%, 0 100%, 0 var(--cut));
  }

  .photo-frame-crop::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgba(18, 58, 156, 0.28), rgba(5, 11, 22, 0.35));
    content: '';
  }

  .photo-frame-crop :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
