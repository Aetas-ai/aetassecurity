---
/** Static (non-hydrated) service glyph shared by the navigation, footer, and service pages. */
import { AppWindow, Crosshair, Network, Radar } from 'lucide-react';
import type { ServiceKey } from '../data/navigation';
import type { ServiceIconKey } from '../data/services';

interface Props {
  service: ServiceKey | ServiceIconKey;
  class?: string;
}

const { service, class: className } = Astro.props;
const icons = { mxdr: Radar, offensive: Crosshair, network: Network, application: AppWindow };
const Icon = icons[service];
---

<Icon className={className} strokeWidth={1.75} aria-hidden="true" focusable="false" />
