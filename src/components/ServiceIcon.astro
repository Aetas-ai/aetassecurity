---
/** Static (non-hydrated) service glyph shared by the navigation and footer. */
import { Crosshair, Radar } from 'lucide-react';
import type { ServiceKey } from '../data/navigation';

interface Props {
  service: ServiceKey;
  class?: string;
}

const { service, class: className } = Astro.props;
const icons = { mxdr: Radar, offensive: Crosshair };
const Icon = icons[service];
---

<Icon className={className} strokeWidth={1.75} aria-hidden="true" focusable="false" />
