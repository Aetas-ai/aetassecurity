---
/**
 * Homepage hero: the line-drawn shield above the approved headline and calls
 * to action, with a strip linking to the three service pages along the bottom.
 */
import Button from './Button.astro';
import ShieldMark from './ShieldMark.astro';
import ServiceIcon from './ServiceIcon.astro';
import { demoLink } from '../data/navigation';
import { services } from '../data/services';
---

<section class="home-hero relative isolate overflow-hidden" aria-labelledby="home-hero-title">
  <div class="home-hero-light" aria-hidden="true"></div>

  <div class="home-hero-main agi-hero-enter mx-auto flex w-full max-w-4xl flex-col items-center px-6 text-center">
    <ShieldMark class="home-hero-shield" />

    <p class="agi-eyebrow mt-8">Advanced Cybersecurity Solutions for your business.</p>

    <h1 id="home-hero-title" class="home-hero-title mt-5 font-display font-semibold">
      <span class="block">Detect threats. Test defenses.</span>
      <span class="block">Strengthen resilience.</span>
    </h1>

    <p class="mt-6 max-w-2xl text-lede text-gray-300">
      Managed Extended Detection and Response (MXDR) and Offensive Security for monitoring, investigation, response, and security testing, guided by experienced security professionals.
    </p>

    <div class="mt-8 flex w-full flex-col justify-center gap-3 sm:w-auto sm:flex-row">
      <Button href={demoLink.href} external stretch>{demoLink.label}</Button>
      <Button href="/contact" variant="secondary" stretch>Contact us</Button>
    </div>
  </div>

  <nav class="home-hero-strip" aria-label="Services">
    <ul class="mx-auto grid max-w-7xl grid-cols-1 md:grid-cols-3">
      {services.map((service) => (
        <li>
          <a href={`/services/${service.slug}`} class="home-hero-service">
            <span class="nav-service-icon h-9 w-9 flex-none">
              <ServiceIcon service={service.icon} class="h-4 w-4" />
            </span>
            <span class="min-w-0">
              <span class="block font-display text-base font-semibold text-white">{service.shortName}</span>
              <span class="block text-[0.8125rem] text-gray-400">{service.group}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</section>

<style>
  .home-hero {
    display: flex;
    min-height: calc(100vh - var(--site-header-height));
    min-height: calc(100dvh - var(--site-header-height));
    flex-direction: column;
    border-bottom: 1px solid var(--line-subtle);
  }

  /* One soft pool of logo-coloured light behind the shield. */
  .home-hero-light {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(38rem 26rem at 50% 18%, rgba(34, 211, 238, 0.12), transparent 70%),
      radial-gradient(50rem 30rem at 50% 30%, rgba(47, 107, 255, 0.08), transparent 70%);
  }

  .home-hero-main {
    flex: 1;
    justify-content: center;
    padding-block: 3rem 2.5rem;
  }

  :global(.home-hero-shield) {
    height: clamp(7.5rem, 20vh, 13rem);
  }

  .home-hero-title {
    color: var(--color-gray-100);
    font-size: var(--text-display);
    letter-spacing: var(--text-display--letter-spacing);
    line-height: 1.04;
  }

  .home-hero-strip {
    border-top: 1px solid var(--line-subtle);
    background: rgba(8, 17, 31, 0.72);
    backdrop-filter: blur(6px);
  }

  .home-hero-strip li + li {
    border-top: 1px solid var(--line-subtle);
  }

  .home-hero-service {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 1.125rem 1.5rem;
    transition: background-color var(--duration-fast) ease;
  }

  .home-hero-service:hover {
    background: rgba(143, 211, 242, 0.05);
  }

  @media (min-width: 768px) {
    .home-hero-strip li + li {
      border-top: 0;
      border-left: 1px solid var(--line-subtle);
    }

    .home-hero-service {
      justify-content: center;
      padding-block: 1.375rem;
    }
  }

  /* Short laptops: keep shield, headline, CTAs and the strip on one screen. */
  @media (min-width: 1024px) and (max-height: 900px) {
    .home-hero-main {
      padding-block: 1.75rem 1.5rem;
    }

    :global(.home-hero-shield) {
      height: clamp(6rem, 17vh, 9.5rem);
    }

    .home-hero-main :global(.agi-eyebrow) {
      margin-top: 1.25rem;
    }
  }
</style>
