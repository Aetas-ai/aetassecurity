---
/**
 * Homepage hero, after the Heimdal reference: the approved headline slides in
 * on the left with rotating taglines (src/scripts/hero-taglines.ts), calls to
 * action, and the breach entry point; the particle globe with the shield
 * (HeroGlobe) sits on the right and tilts toward the pointer. A strip linking
 * every service page runs along the bottom. Entrances animate transform only,
 * so the headline paints immediately.
 */
import Button from './Button.astro';
import HeroAtmosphere from './HeroAtmosphere.astro';
import HeroGlobe from './HeroGlobe.astro';
import ServiceIcon from './ServiceIcon.astro';
import { heroTaglines } from '../data/approach';
import { breachLink, demoLink } from '../data/navigation';
import { services } from '../data/services';
---

<section class="home-hero relative isolate overflow-hidden" aria-labelledby="home-hero-title">
  <HeroAtmosphere />

  <div class="home-hero-main mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-10 px-6 lg:grid-cols-12 lg:gap-6">
    <div class="home-hero-copy lg:col-span-6">
      <p class="agi-eyebrow">Advanced Cybersecurity Solutions for your business.</p>

      <h1 id="home-hero-title" class="home-hero-title mt-5 font-display font-semibold">
        <span class="block">Detect threats.</span>
        <span class="block">Test defenses.</span>
        <span class="home-hero-accent block">Strengthen resilience.</span>
      </h1>

      <p class="home-hero-tagline mt-5">
        <span class="sr-only">{heroTaglines[0]}</span>
        <span class="home-hero-tagline-text" aria-hidden="true" data-taglines={JSON.stringify(heroTaglines)}>{heroTaglines[0]}</span>
      </p>

      <p class="home-hero-lede mt-4 max-w-xl text-lede text-gray-300">
        Managed Extended Detection and Response (MXDR), Incident Response, and Offensive Security for monitoring, investigation, response, and security testing, guided by experienced security professionals.
      </p>

      <div class="home-hero-actions mt-8 flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <Button href={demoLink.href} external stretch>{demoLink.label}</Button>
        <Button href="/services" variant="secondary" stretch>Explore services</Button>
      </div>

      <a href={breachLink.href} class="home-hero-breach mt-5 inline-block">{breachLink.label} <span>Get help now</span></a>
    </div>

    <div class="home-hero-visual lg:col-span-6">
      <HeroGlobe />
    </div>
  </div>

  <nav class="home-hero-strip" aria-label="Services">
    <ul class="mx-auto grid max-w-7xl grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((service) => (
        <li>
          <a href={`/services/${service.slug}`} class="home-hero-service">
            <span class="nav-service-icon h-9 w-9 flex-none">
              <ServiceIcon service={service.icon} class="h-4 w-4" />
            </span>
            <span class="min-w-0">
              <span class="block font-display text-base font-semibold text-white">{service.shortName}</span>
              <span class="block text-[0.8125rem] text-gray-400">{service.group}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</section>

<style>
  .home-hero {
    display: flex;
    min-height: calc(100vh - var(--site-header-height));
    min-height: calc(100dvh - var(--site-header-height));
    flex-direction: column;
    border-bottom: 1px solid var(--line-subtle);
  }

  .home-hero-main {
    flex: 1;
    padding-block: 3rem 2.5rem;
  }

  .home-hero-title {
    color: var(--color-gray-100);
    font-size: var(--text-display);
    letter-spacing: var(--text-display--letter-spacing);
    line-height: 1.02;
  }

  .home-hero-accent {
    color: var(--color-accent-text);
  }

  /* Fixed height so typing never shifts the layout below it. */
  .home-hero-tagline {
    min-height: calc(2 * 1.4em);
    color: #ffffff;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    font-weight: 500;
    line-height: 1.4;
  }

  .home-hero-tagline-text:not(.is-typing)::after,
  .home-hero-tagline :global(.tagline-letter.is-caret)::after {
    display: inline-block;
    width: 2px;
    height: 1.05em;
    margin-left: 0.2em;
    background: var(--color-accent);
    content: '';
    vertical-align: -0.12em;
  }

  .home-hero-tagline :global(.tagline-letter.is-caret)::after {
    position: absolute;
    top: 50%;
    left: 100%;
    margin-left: 0.1em;
    transform: translateY(-50%);
  }

  .home-hero-tagline :global(.tagline-letter) {
    position: relative;
  }

  .home-hero-tagline :global(.tagline-word) {
    display: inline-block;
    white-space: nowrap;
  }

  .home-hero-tagline :global(.tagline-letter) {
    display: inline-block;
    opacity: 0;
    transform: translateY(5px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .home-hero-tagline :global(.tagline-letter.is-on) {
    opacity: 1;
    transform: translateY(0);
  }

  .home-hero-breach {
    color: var(--color-gray-300);
    font-size: 0.875rem;
  }

  .home-hero-breach span {
    margin-left: 0.25rem;
    color: var(--color-accent-text);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    text-underline-offset: 0.3em;
  }

  .home-hero-breach:hover span {
    text-decoration-color: currentColor;
  }

  .home-hero-visual {
    max-width: 30rem;
    width: 100%;
    margin-inline: auto;
  }

  @media (min-width: 1024px) {
    .home-hero-visual {
      max-width: none;
    }
  }

  /* Entrances (after the reference): the headline slides in from the left,
     calls to action rise, the globe grows in from the bottom right. Text
     animates transform only, so it paints immediately. */
  @media (prefers-reduced-motion: no-preference) {
    .home-hero-copy > * {
      animation: hero-slide 1.1s var(--ease-out-expo) both;
    }

    .home-hero-copy > :nth-child(2) { animation-delay: 80ms; }
    .home-hero-copy > :nth-child(3) { animation-delay: 160ms; }
    .home-hero-copy > :nth-child(4) { animation-delay: 220ms; }

    .home-hero-copy > .home-hero-actions,
    .home-hero-copy > .home-hero-breach {
      animation: hero-rise 1s var(--ease-out-expo) 320ms both;
    }

    .home-hero-visual {
      transform-origin: 80% 90%;
      animation: hero-grow 1.6s var(--ease-out-expo) 120ms both;
    }
  }

  @keyframes hero-slide {
    from { transform: translate3d(-48px, 0, 0); }
  }

  @keyframes hero-rise {
    from { transform: translate3d(0, 28px, 0); }
  }

  @keyframes hero-grow {
    from { opacity: 0; transform: scale(0.85); }
  }

  .home-hero-strip {
    border-top: 1px solid var(--line-subtle);
    background: rgba(8, 17, 31, 0.72);
    backdrop-filter: blur(6px);
  }

  .home-hero-strip li + li {
    border-top: 1px solid var(--line-subtle);
  }

  .home-hero-service {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 1.125rem 1.5rem;
    transition: background-color var(--duration-fast) ease;
  }

  .home-hero-service:hover {
    background: rgba(143, 211, 242, 0.05);
  }

  @media (min-width: 640px) {
    .home-hero-strip li + li {
      border-top: 0;
    }

    .home-hero-strip li:nth-child(n + 3) {
      border-top: 1px solid var(--line-subtle);
    }

    .home-hero-strip li:nth-child(even) {
      border-left: 1px solid var(--line-subtle);
    }
  }

  @media (min-width: 1024px) {
    .home-hero-strip li:nth-child(n + 3) {
      border-top: 0;
    }

    .home-hero-strip li + li {
      border-left: 1px solid var(--line-subtle);
    }

    .home-hero-service {
      justify-content: center;
      padding-block: 1.375rem;
    }
  }

  /* Short laptops: headline, tagline, CTAs, and the strip on one screen. */
  @media (min-width: 1024px) and (max-height: 900px) {
    .home-hero-main {
      padding-block: 1.5rem 1.25rem;
    }

    .home-hero-tagline {
      min-height: 1.4em;
    }

    .home-hero-visual {
      max-width: min(100%, calc(100dvh - var(--site-header-height) - 9rem));
      margin-inline: auto;
    }
  }
</style>
