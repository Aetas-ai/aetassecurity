---
/**
 * Homepage platform diagram (after the Arctic Wolf Aurora, Heimdal, and
 * CrowdStrike Falcon platform graphics): the services grouped by outcome
 * (`outcomes` in src/data/services.ts) as module tiles, joined to an
 * Expert in the Loop core that sits on top of the client's environment.
 * Every tile is a real link. Connector signals pause off-screen (data-motion)
 * and are static under reduced motion; below lg the columns stack and the
 * connectors hide. The two bar labels are drafted copy (CONTENT-TODO.md).
 */
import { AppWindow, Check, ClipboardCheck, Clock, Handshake, MonitorCheck, Network, Radar, Siren } from 'lucide-react';
import { outcomes } from '../data/services';

const icons: Record<string, typeof Radar> = {
  '/services/mxdr': Radar,
  '/services/incident-response': Siren,
  '/services#threat-monitoring': Clock,
  '/services#soc': MonitorCheck,
  '/services/network-security-testing': Network,
  '/services/application-security-testing': AppWindow,
  '/services#compliance': ClipboardCheck,
  '/services#co-management': Handshake,
};

const core = ['Human Led AI', 'Analyst approval before containment', 'Every action documented'];
const environment = ['Endpoints', 'Identity', 'Email', 'Network', 'Cloud environments'];
---

<div class="platform" data-motion>
  <ol class="platform-columns">
    {outcomes.map((outcome, index) => (
      <li class="platform-column" style={`--column-index: ${index}`}>
        <h3 class="font-display text-h3 font-semibold text-strong">{outcome.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">{outcome.body}</p>
        <ul class="platform-modules">
          {outcome.items.map((item) => {
            const Icon = icons[item.href] ?? Radar;
            return (
              <li>
                <a href={item.href} class="platform-module as-chamfer">
                  <Icon className="h-4 w-4 flex-none" strokeWidth={1.75} aria-hidden="true" focusable="false" />
                  <span>{item.label}</span>
                </a>
              </li>
            );
          })}
        </ul>
        <span class="platform-connector" aria-hidden="true"><span class="platform-signal"></span></span>
      </li>
    ))}
  </ol>

  <div class="platform-core as-chamfer">
    <p class="agi-eyebrow">Expert in the Loop</p>
    <ul class="platform-chips">
      {core.map((item) => (
        <li><Check className="h-3.5 w-3.5" strokeWidth={2.25} aria-hidden="true" focusable="false" />{item}</li>
      ))}
    </ul>
  </div>

  <div class="platform-base">
    <p class="platform-base-label">Your environment</p>
    <ul class="platform-chips platform-chips--quiet">
      {environment.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</div>

<style>
  .platform {
    display: grid;
    gap: 1.25rem;
    margin-top: 3rem;
  }

  .platform-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }

  @media (min-width: 1024px) {
    .platform-columns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  .platform-column {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(143, 211, 242, 0.18);
    background: rgba(5, 11, 22, 0.32);
    padding: 1.5rem;
    transition: border-color var(--duration-base) ease, background-color var(--duration-base) ease;
  }

  .platform-column:hover,
  .platform-column:focus-within {
    border-color: rgba(143, 211, 242, 0.55);
    background: rgba(5, 11, 22, 0.46);
  }

  .platform-modules {
    display: grid;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .platform-module {
    --panel-cut: var(--cut-sm);
    --panel-fill: rgba(255, 255, 255, 0.06);
    --panel-line: rgba(143, 211, 242, 0.26);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.625rem 0.875rem;
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .platform-module :global(svg) {
    color: var(--color-accent-text);
  }

  .platform-module:hover,
  .platform-module:focus-visible {
    --panel-fill: rgba(143, 211, 242, 0.14);
    --panel-line: var(--color-accent-text);
  }

  /* Connector from each column down to the core (wide screens only). */
  .platform-connector {
    display: none;
  }

  @media (min-width: 1024px) {
    .platform-connector {
      position: absolute;
      top: 100%;
      left: 50%;
      display: block;
      width: 2px;
      height: 1.5rem;
      overflow: hidden;
      background: linear-gradient(180deg, rgba(143, 211, 242, 0.5), rgba(34, 211, 238, 0.9));
      opacity: 0.55;
      transform: translateX(-50%);
      transition: opacity var(--duration-base) ease;
    }

    .platform-column:hover .platform-connector,
    .platform-column:focus-within .platform-connector {
      opacity: 1;
    }
  }

  .platform-signal {
    position: absolute;
    top: 0;
    left: -1px;
    width: 4px;
    height: 0.5rem;
    border-radius: 9999px;
    background: #ffffff;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .platform-signal {
      animation: platform-signal 2.4s ease-in infinite;
      animation-delay: calc(var(--column-index) * 0.8s);
      will-change: transform, opacity;
    }
  }

  @keyframes platform-signal {
    0% { opacity: 0; transform: translateY(-0.5rem); }
    20% { opacity: 1; }
    70%, 100% { opacity: 0; transform: translateY(1.5rem); }
  }

  .platform-core {
    --panel-fill: rgba(5, 11, 22, 0.6);
    --panel-line: rgba(34, 211, 238, 0.55);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: 1.125rem 1.5rem;
  }

  /* The logo gradient along the core's top edge. */
  .platform-core::after {
    position: absolute;
    inset: 0 var(--cut) auto var(--cut);
    height: 2px;
    background: var(--brand-gradient);
    content: '';
  }

  .platform-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .platform-chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .platform-chips :global(svg) {
    color: var(--color-accent-text);
  }

  .platform-base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    border: 1px dashed rgba(143, 211, 242, 0.32);
    padding: 1rem 1.5rem;
  }

  .platform-base-label {
    color: var(--surface-text-muted);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .platform-chips--quiet {
    gap: 0.5rem;
    color: var(--surface-text-muted);
    font-weight: 500;
  }

  .platform-chips--quiet li {
    border: 1px solid rgba(143, 211, 242, 0.24);
    padding: 0.25rem 0.625rem;
  }
</style>
