---
/**
 * The Aetas Security shield as line art, traced from the logo master
 * (AS-LOGO-RGB_HORIZONTAL.png, 295×352). On load the outline draws itself once
 * and the logo gradient fills in faintly; afterwards the glow breathes slowly.
 * Decorative (aria-hidden); paused off-screen (data-motion); drawn and static
 * under reduced motion.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const parts = [
  // Crown with its triangular cut-out.
  'M26 0 H269 L282 40 L163 146 H132 L13 40 Z M86 44 H209 L147.5 99 Z',
  // Left and right wings.
  'M0 70 L124 180 V352 L80 309 V200 L0 130 Z',
  'M295 70 L171 180 V352 L215 309 V200 L295 130 Z',
];
---

<div class:list={['shield-mark', className]} aria-hidden="true" data-motion>
  <svg viewBox="-12 -12 319 376" focusable="false">
    <defs>
      <linearGradient id="shield-fill" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#22d3ee" />
        <stop offset="1" stop-color="#2f6bff" />
      </linearGradient>
    </defs>
    {parts.map((d, index) => (
      <path class="shield-fill" d={d} fill="url(#shield-fill)" fill-rule="evenodd" style={`animation-delay: ${0.9 + index * 0.15}s`} />
    ))}
    {parts.map((d, index) => (
      <path class="shield-line" d={d} pathLength="1" stroke="url(#shield-fill)" vector-effect="non-scaling-stroke" style={`animation-delay: ${index * 0.18}s`} />
    ))}
  </svg>
</div>

<style>
  .shield-mark {
    display: flex;
    justify-content: center;
    filter: drop-shadow(0 0 28px rgba(34, 211, 238, 0.22));
  }

  .shield-mark svg {
    height: 100%;
    width: auto;
    overflow: visible;
  }

  .shield-line {
    fill: none;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .shield-fill {
    opacity: 0.14;
  }

  @media (prefers-reduced-motion: no-preference) {
    .shield-mark {
      animation: shield-breathe 6s ease-in-out 2s infinite;
    }

    .shield-line {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: shield-draw 1.4s var(--ease-out-expo) forwards;
    }

    .shield-fill {
      opacity: 0;
      animation: shield-fill 1.2s ease-out forwards;
    }
  }

  @keyframes shield-draw {
    to { stroke-dashoffset: 0; }
  }

  @keyframes shield-fill {
    to { opacity: 0.14; }
  }

  @keyframes shield-breathe {
    0%, 100% { filter: drop-shadow(0 0 28px rgba(34, 211, 238, 0.22)); }
    50% { filter: drop-shadow(0 0 44px rgba(47, 107, 255, 0.36)); }
  }
</style>
